generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_URL") 
  directUrl = env("POSTGRES_URL")
}

model User {
    id          Int     @id @default(autoincrement())
    username    String  @unique
    password    String
    role        UserRole @default(ADMIN) 
}

enum UserRole {
    USER    
    ADMIN 
}

model Product {
  id                Int        @id @default(autoincrement())
  img               String[]
  name_az           String
  name_en           String?    
  name_ru           String?    
  description_az    String
  description_en    String?    
  description_ru    String?    
  price             Float  
  metadata          String?
  categoryId        Int
  subcategoryId     Int
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory       Subcategory @relation(fields: [subcategoryId], references: [id])
  ingridients       String[]
  sizes             String[]    @default([])
  status            Boolean     @default(true)
  isStok            Boolean     @default(true)
}

model Category {
  id               Int             @id @default(autoincrement())
  img              String[]
  name_az          String
  name_en          String
  name_ru          String
  products         Product[]       // Add this line to define the opposite relation
  subcategories    Subcategory[]   // Add this line for the opposite relation to `Subcategory`
}

model Subcategory {
  id               Int           @id @default(autoincrement())
  name_az          String
  name_en          String?        
  name_ru          String?        
  categoryId       Int
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products         Product[]      // Add this line to define the opposite relation
}



